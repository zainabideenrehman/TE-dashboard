# Default: a populated synthetic demo, with no credentials or AI calls.
DATA_MODE=DEMO
# Optional Google project used by the server-side official Google client.
GOOGLE_CLOUD_PROJECT_ID=
# Only local development storage is implemented; Firestore is a later adapter.
CONFIG_STORAGE=local
# For real Sheets locally: set DATA_MODE=GOOGLE and uncomment with your actual path.
# Store the service-account JSON key OUTSIDE this repository. Path only, not key contents.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/agency-reader.json
# No gcloud login is needed when using a service-account key file.
# On Cloud Run attach the service account; do not deploy a key.
# Cloud Run is blocked until durable metadata storage and a protected cache are implemented.
# Vercel live deployment: set these as sensitive server-side environment variables.
# GOOGLE_SERVICE_ACCOUNT_JSON= (entire service-account JSON; never NEXT_PUBLIC_)
# SOURCE_REGISTRY_JSON= (approved sources and mappings only, no parsed records/snapshots)
# DASHBOARD_ORIGIN=https://your-protected-dashboard.vercel.app
# Hosted mappings are read-only; publish revisions locally and replace configuration.
# Keep Vercel protection until app login is verified, then use Standard Protection.
# DASHBOARD_USERS_JSON= (array of approved email/salt/scrypt-hash entries)
# DASHBOARD_SESSION_SECRET= (random secret, at least 32 characters)
# Generate and publish with scripts/configure-accounts.mjs; never NEXT_PUBLIC_.
# Server-side proposal generation only; never expose these as NEXT_PUBLIC_ variables.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2
# PROPOSAL_KNOWLEDGE_DIR=/absolute/path/to/proposal-knowledge
# GPT_MCP_SERVER_URL=https://your-gpt-mcp.example.com/mcp
# CLAUDE_MCP_SERVER_URL=https://your-claude-mcp.example.com/mcp
# MCP_OAUTH_ISSUER=https://your-oauth-provider.example.com
# MCP_OAUTH_AUDIENCE=agency-command-center-mcp
# MCP_BEARER_TOKEN= (local-only development fallback; do not use as ChatGPT production auth)
